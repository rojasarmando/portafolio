---
import { getCollection } from 'astro:content';
import Page from '../../../layouts/Page.astro';
import { t, type Lang } from '../../../i18n/utils';
import Icon from '../../../components/Icon.astro';
import Badge from '../../../components/Badge.astro';

const lang: Lang = 'en';
const dict = t(lang);

const posts = (await getCollection('blog'))
  .filter((post) => post.data.lang === lang)
  .sort((a, b) => b.data.publishedOn.getTime() - a.data.publishedOn.getTime());
---

<Page lang={lang} title={`${dict.blog.title} — Armando Rojas`} description={dict.blog.subtitle}>
  <section class="py-24" id="blog">
    <div class="mx-auto max-w-[960px] px-6">
      <div class="mb-16 flex flex-col items-center gap-4 text-center" data-reveal>
        <span class="font-mono text-sm font-bold uppercase tracking-[0.2em] text-primary">
          {dict.blog.eyebrow}
        </span>
        <h1 class="text-4xl font-extrabold tracking-tight text-white md:text-5xl">
          {dict.blog.title}
        </h1>
        <p class="mt-2 max-w-2xl text-lg text-slate-500">
          {dict.blog.subtitle}
        </p>
        <div class="h-1.5 w-16 rounded-full bg-primary"></div>
      </div>
      {posts.length === 0 ? (
        <p class="text-center text-slate-500" data-reveal>{dict.blog.noPosts}</p>
      ) : (
        <ul class="space-y-8">
          {posts.map((post) => (
            <li
              class="group rounded-2xl border border-slate-700/50 bg-background-card p-8 transition-all hover:-translate-y-1 hover:border-primary/40 hover:shadow-2xl hover:shadow-primary/10"
              data-reveal
            >
              <div class="mb-3 flex items-center gap-3 font-mono text-[10px] uppercase tracking-widest text-slate-500">
                <span>{dict.blog.publishedOn} {post.data.publishedOn.toISOString().slice(0, 10)}</span>
                {post.data.status && <Badge status={post.data.status} size="sm" />}
              </div>
              <h2 class="text-2xl font-bold text-white transition-colors group-hover:text-primary">
                <a href={`/en/blog/${post.id.replace(/\.md$/, '')}/`} class="after:absolute after:inset-0 after:content-['']">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-3 text-base leading-relaxed text-slate-400">{post.data.excerpt}</p>
              <div class="mt-5 flex flex-wrap items-center gap-3">
                {post.data.tags.map((tag: string) => (
                  <span class="rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-[10px] font-bold uppercase text-primary">
                    {tag}
                  </span>
                ))}
                <span class="ml-auto inline-flex items-center gap-2 text-sm font-bold text-primary">
                  {dict.blog.readMore}
                  <Icon name="arrowRight" class="size-4" />
                </span>
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Page>
