---
import Layout from '@/layouts/Layout.astro'
import IconCheckmark from '@/components/IconCheckmark.astro'
import Link from '@/components/Link.astro'
import { Image } from 'astro:assets'
import developerImage from '@/images/developer.svg'
import mindMapImage from '@/images/mind-map.svg'
import codeReviewImage from '@/images/code-review.svg'
import dotsTriangle from '@/images/dots-triangle.svg'
import avatarImage from '@/images/avatar.png'
---

<Layout title="Home">
  <main>
    <section
      class="hero mx-auto max-w-3xl flex flex-col sm:flex-row justify-between py-16 mt-24 px-4 xl:px-0"
    >
      <div class="text-4xl font-bold text-center sm:text-left">
        <div class="leading-tight dark:text-gray-100">
          Hi! I'm Armando Rojas
        </div>
        <div
          class="text-indigo-700 dark:text-indigo-500 leading-tight sm:mr-16"
        >
          Full Stack Developer
        </div>
      </div>
      <div class="mt-8 sm:mt-0">
        <Image src={developerImage} alt="developer" class="mx-auto sm:mx-0" />
      </div>
    </section>
    <!-- end hero -->

    <section class="max-w-3xl mx-auto px-4 xl:px-0 mb-1 " >
      <p class="dark:text-gray-100">
        Soy Ingeniero de Sistemas especializado en desarrollo Full Stack con
        experiencia en tecnologías como NestJS, Angular, Laravel, FastAPI, Ionic
        y Next.js. 
      </p>

      
 
        <br />
        <p class="dark:text-gray-100">
        He liderado proyectos de desarrollo de aplicaciones web,
        desde el levantamiento de información hasta la implementación, abarcando
        el diseño de bases de datos, la creación de APIs y microservicios.

      </p>
      <br />

      <div class="flex justify-between items-center my-14">
        <div class="w-full sm:w-1/2 px-8 py-8 sm:py-0">
          <Image src={mindMapImage} alt="mind map" />
        </div>
        <div class="w-1/2 px-8 hidden sm:flex justify-end">
          <Image src={codeReviewImage} alt="code review" />
        </div>
      </div>
      <p class="dark:text-gray-100">

        Cuento con experiencia en el desarrollo de módulos para sistemas ERP
        como Odoo y ERPNext, contribuyendo al mejoramiento y personalización de
        según las necesidades específicas de cada cliente.
        
        
      </p>
      <br />


      <p class="dark:text-gray-100">
        También cuento con
        experiencia en la configuración de integración continua con Bitrise y
        Jenkins, utilizo Docker para la creación y gestión de contenedores, lo
        que facilita el desarrollo y despliegue de aplicaciones. Tengo
        conocimientos en la administración de servidores y servicios en la nube
        con AWS y Digital Ocean. Mi enfoque se centra en ofrecer soluciones
        tecnológicas efectivas y de alta calidad, adaptándome a las necesidades
        del proyecto y garantizando un rendimiento óptimo.
      </p>
    </section>

    <section
      id="projects"
      class="scroll-mt-16 max-w-3xl mx-auto border-t border-b border-gray-300 dark:border-gray-700 py-16 mb-16 relative px-4 xl:px-0"
    >
      <h3 class="dark:text-gray-100 font-bold">Experiencia Laboral:</h3>
      <br />


      <div class="absolute right-0 transform rotate-180 translate-x-[120%]">
        <Image src={dotsTriangle} alt="dots" class="hidden xl:block" />
      </div>

      
<ol class="relative border-s border-gray-200 dark:border-gray-700">                  
  <li class="mb-10 ms-6">            
      <span class="absolute flex items-center justify-center w-6 h-6 bg-blue-100 rounded-full -start-3 ring-8 ring-white dark:ring-gray-900 dark:bg-blue-900">
          <svg class="w-2.5 h-2.5 text-blue-800 dark:text-blue-300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
              <path d="M20 4a2 2 0 0 0-2-2h-2V1a1 1 0 0 0-2 0v1h-3V1a1 1 0 0 0-2 0v1H6V1a1 1 0 0 0-2 0v1H2a2 2 0 0 0-2 2v2h20V4ZM0 18a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8H0v10Zm5-8h10a1 1 0 0 1 0 2H5a1 1 0 0 1 0-2Z"/>
          </svg>
      </span>
      <h3 class="flex items-center mb-1 text-lg font-semibold text-gray-900 dark:text-white">Flowbite Application UI v2.0.0 <span class="bg-blue-100 text-blue-800 text-sm font-medium me-2 px-2.5 py-0.5 rounded dark:bg-blue-900 dark:text-blue-300 ms-3">Latest</span></h3>
      <time class="block mb-2 text-sm font-normal leading-none text-gray-400 dark:text-gray-500">Released on January 13th, 2022</time>
      <p class="mb-4 text-base font-normal text-gray-500 dark:text-gray-400">Get access to over 20+ pages including a dashboard layout, charts, kanban board, calendar, and pre-order E-commerce & Marketing pages.</p>
      <a href="#" class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-900 bg-white border border-gray-200 rounded-lg hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:outline-none focus:ring-gray-100 focus:text-blue-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700 dark:focus:ring-gray-700"><svg class="w-3.5 h-3.5 me-2.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
  <path d="M14.707 7.793a1 1 0 0 0-1.414 0L11 10.086V1.5a1 1 0 0 0-2 0v8.586L6.707 7.793a1 1 0 1 0-1.414 1.414l4 4a1 1 0 0 0 1.416 0l4-4a1 1 0 0 0-.002-1.414Z"/>
  <path d="M18 12h-2.55l-2.975 2.975a3.5 3.5 0 0 1-4.95 0L4.55 12H2a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-4a2 2 0 0 0-2-2Zm-3 5a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"/>
</svg> Download ZIP</a>
  </li>
  <li class="mb-10 ms-6">
      <span class="absolute flex items-center justify-center w-6 h-6 bg-blue-100 rounded-full -start-3 ring-8 ring-white dark:ring-gray-900 dark:bg-blue-900">
          <svg class="w-2.5 h-2.5 text-blue-800 dark:text-blue-300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
              <path d="M20 4a2 2 0 0 0-2-2h-2V1a1 1 0 0 0-2 0v1h-3V1a1 1 0 0 0-2 0v1H6V1a1 1 0 0 0-2 0v1H2a2 2 0 0 0-2 2v2h20V4ZM0 18a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8H0v10Zm5-8h10a1 1 0 0 1 0 2H5a1 1 0 0 1 0-2Z"/>
          </svg>
      </span>
      <h3 class="mb-1 text-lg font-semibold text-gray-900 dark:text-white">Flowbite Figma v1.3.0</h3>
      <time class="block mb-2 text-sm font-normal leading-none text-gray-400 dark:text-gray-500">Released on December 7th, 2021</time>
      <p class="text-base font-normal text-gray-500 dark:text-gray-400">All of the pages and components are first designed in Figma and we keep a parity between the two versions even as we update the project.</p>
  </li>
  <li class="ms-6">
      <span class="absolute flex items-center justify-center w-6 h-6 bg-blue-100 rounded-full -start-3 ring-8 ring-white dark:ring-gray-900 dark:bg-blue-900">
          <svg class="w-2.5 h-2.5 text-blue-800 dark:text-blue-300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
              <path d="M20 4a2 2 0 0 0-2-2h-2V1a1 1 0 0 0-2 0v1h-3V1a1 1 0 0 0-2 0v1H6V1a1 1 0 0 0-2 0v1H2a2 2 0 0 0-2 2v2h20V4ZM0 18a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8H0v10Zm5-8h10a1 1 0 0 1 0 2H5a1 1 0 0 1 0-2Z"/>
          </svg>
      </span>
      <h3 class="mb-1 text-lg font-semibold text-gray-900 dark:text-white">Flowbite Library v1.2.2</h3>
      <time class="block mb-2 text-sm font-normal leading-none text-gray-400 dark:text-gray-500">Released on December 2nd, 2021</time>
      <p class="text-base font-normal text-gray-500 dark:text-gray-400">Get started with dozens of web components and interactive elements built on top of Tailwind CSS.</p>
  </li>
</ol>


    </section>

    <section
      id="about"
      class="scroll-mt-32 max-w-3xl mx-auto relative px-4 xl:px-0"
    >
      <h3 class="dark:text-gray-100 font-bold">Get to know me</h3>

      <div class="flex items-center flex-col sm:flex-row mt-6">
        <Image src={avatarImage} alt="avatar" class="rounded-full w-32 h-32" />
        <div>
          <p class="dark:text-gray-100 sm:ml-6 mt-6 sm:mt-0">
            Lorem ipsum dolor sit amet, consectetur adipisicing elit. Quibusdam
            quam praesentium eligendi autem voluptate vero quo voluptatem, qui
            possimus debitis iste amet ea voluptatum aut consectetur. Velit quos
            at explicabo?
          </p>
        </div>
      </div>

      <div class="my-16">
        <iframe
          class="w-full aspect-video"
          src="https://www.youtube.com/embed/wL8DVHuWI7Y?si=1f49Sb_uY_kuXl4f"
          allowfullscreen></iframe>
      </div>
    </section>

    <section
      id="contact"
      class="scroll-mt-28 bg-gray-100 dark:bg-slate-800 mt-10 py-12 px-4 xl:px-0"
    >
      <div class="max-w-3xl mx-auto relative">
        <h3 class="font-bold dark:text-gray-100">Contact me</h3>

        <div class="absolute left-0 transform -translate-x-[120%] rotate-180">
          <Image src={dotsTriangle} alt="dots" />
        </div>

        <p class="dark:text-gray-100 mt-6">
          Static sites cannot submit forms on their own. However, services like
          <Link href="https://www.netlify.com/docs/form-handling" newTab>
            Netlify Forms
          </Link>
          or
          <Link href="https://formspree.io" newTab>FormSpree</Link>
          can help you do this without a backend.
        </p>

        <div class="mt-12">
          <form action="#" class="grid grid-cols-2 gap-6">
            <div class="col-span-2 sm:col-span-1">
              <label for="name" class="block dark:text-gray-100">Name</label>
              <input
                type="text"
                name="name"
                id="name"
                placeholder="Your name"
                class="block dark:bg-slate-700 dark:text-gray-100 w-full rounded-md border-0 text-gray-900 shadow placeholder:text-gray-400 focus:ring-1 focus:ring-inset focus:ring-indigo-600 p-4 mt-2"
              />
            </div>
            <div class="col-span-2 sm:col-span-1">
              <label for="email" class="block dark:text-gray-100">Email</label>
              <input
                type="text"
                name="email"
                id="email"
                placeholder="Your email"
                class="block dark:bg-slate-700 dark:text-gray-100 w-full rounded-md border-0 text-gray-900 shadow placeholder:text-gray-400 focus:ring-1 focus:ring-inset focus:ring-indigo-600 p-4 mt-2"
              />
            </div>

            <div class="col-span-2">
              <label for="message" class="block dark:text-gray-100"
                >Message</label
              >
              <textarea
                rows="8"
                name="message"
                id="message"
                class="block dark:bg-slate-700 dark:text-gray-100 w-full rounded-md border-0 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-slate-700 placeholder:text-gray-400 focus:ring-1 focus:ring-inset focus:ring-indigo-600 dark:focus:ring-indigo-600 p-4 mt-2"
                placeholder="Enter your message here"></textarea>
            </div>

            <div class="col-span-2">
              <div class="flex justify-end w-full">
                <input
                  type="submit"
                  value="Submit"
                  class="block bg-indigo-700 hover:bg-indigo-900 focus:bg-indigo-900 text-white text-sm font-semibold tracking-wide uppercase shadow rounded cursor-pointer px-6 py-3"
                />
              </div>
            </div>
          </form>
        </div>
      </div>
    </section>
  </main>
</Layout>
