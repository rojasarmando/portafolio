---
import BaseLayout from './BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Ecosystem from '../components/Ecosystem.astro';
import Trajectory from '../components/Trajectory.astro';
import Projects from '../components/Projects.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
import { t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  ogImage?: string;
  /** When true, omit the global homepage sections (Hero/Ecosystem/...). * Used for detail pages like /projects/[slug]. */
  bare?: boolean;
}

const { lang, title, description, ogImage, bare = false } = Astro.props;
const dict = t(lang);
const pageTitle = title ?? dict.meta.title;
const pageDescription = description ?? dict.meta.description;
---

<BaseLayout
  lang={lang}
  title={pageTitle}
  description={pageDescription}
  ogImage={ogImage}
>
  <Navbar lang={lang} />
  <main class:list={[bare ? 'pt-16' : 'pt-16']}>
    {bare ? (
      <slot />
    ) : (
      <>
        <Hero lang={lang} />
        <Ecosystem lang={lang} />
        <Trajectory lang={lang} />
        <Projects lang={lang} />
        <Cta lang={lang} />
      </>
    )}
  </main>
  <Footer lang={lang} />
</BaseLayout>
