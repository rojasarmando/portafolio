---
import site from '../data/site.json';
import { t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);

function formatPeriod(start: string, end: string | undefined, current: boolean | undefined, lang: Lang): string {
  const endLabel = current
    ? (lang === 'es' ? 'actualidad' : 'present')
    : (end ?? '—');
  return `${start} → ${endLabel}`;
}
---

<section class="py-24" id="experience">
  <div class="mx-auto max-w-[1280px] px-6">
    <div class="mb-16 flex items-center gap-6" data-reveal>
      <h2 class="shrink-0 text-4xl font-extrabold tracking-tight text-white">
        {dict.trajectory.title}
      </h2>
      <div class="h-px w-full bg-slate-800"></div>
    </div>
    <div class="space-y-12">
      {
        site.trajectory.map((job, index) => {
          const item = dict.trajectory.items[index];
          return (
            <div
              class="group relative border-l-2 border-slate-800 pl-12 last:border-0 last:pb-0"
              data-reveal
            >
              <div
                class={`absolute left-[-9px] top-0 size-4 rounded-full ring-4 ring-background-dark transition-colors ${
                  job.current
                    ? 'bg-primary'
                    : 'bg-slate-700 group-hover:bg-primary'
                }`}
              />
              <div class="flex flex-col items-start justify-between gap-4 md:flex-row">
                <div>
                  <h3 class="text-2xl font-bold text-white">{job.role}</h3>
                  <p class="text-lg font-bold text-primary">{job.company}</p>
                  <p class="mt-1 font-mono text-xs uppercase tracking-widest text-slate-500">
                    {formatPeriod(job.startDate, job.endDate, job.current, lang)}
                  </p>
                </div>
                {job.current && (
                  <span class="rounded-full border border-primary/20 bg-primary/10 px-4 py-1.5 text-xs font-bold text-primary">
                    {dict.trajectory.currentBadge}
                  </span>
                )}
              </div>
              <p
                class={`max-w-4xl text-lg leading-relaxed text-slate-400 ${job.current ? 'mt-6' : 'mt-4'}`}
              >
                {item.scope}
              </p>
              {item.outcomes && item.outcomes.length > 0 && (
                <div class="mt-4 max-w-4xl">
                  <p class="font-mono text-[10px] font-bold uppercase tracking-widest text-slate-500">
                    {dict.trajectory.outcomesLabel}
                  </p>
                  <ul class="mt-2 space-y-2">
                    {item.outcomes.map((outcome: string) => (
                      <li class="flex items-start gap-3 text-base text-slate-300">
                        <span class="mt-2 size-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
                        <span>{outcome}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {job.stack && job.stack.length > 0 && (
                <div class="mt-5 flex flex-wrap gap-2">
                  {job.stack.map((tag: string) => (
                    <span class="rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-[10px] font-bold uppercase text-primary">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>
          );
        })
      }
    </div>
  </div>
</section>
