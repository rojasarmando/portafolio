---
import Icon from './Icon.astro';
import Badge from './Badge.astro';
import site from '../data/site.json';
import { t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);

const statusLabel = (status: string): string => {
  if (status === 'verified') return dict.hero.evidence.verified;
  if (status === 'learning') return dict.hero.evidence.learning;
  if (status === 'anonymized') return 'case';
  if (status === 'archived') return 'archived';
  return dict.hero.evidence.partial;
};
---

<section class="relative hero-gradient py-16 lg:py-24" id="about">
  <div class="mx-auto max-w-[1280px] px-6">
    <div class="grid items-center gap-12 lg:grid-cols-12">
      <div class="flex flex-col gap-8 lg:col-span-6">
        <div
          class="inline-flex w-fit items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-primary"
          data-reveal
        >
          <span class="relative flex h-2 w-2">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary opacity-75"
            ></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-primary"
            ></span>
          </span>
          {dict.hero.badge}
        </div>
        <div class="flex flex-col gap-4" data-reveal>
          <h1
            class="text-5xl font-extrabold leading-[1.1] tracking-tight text-white md:text-6xl"
          >
            {dict.hero.titleName}
            <span class="block text-primary">{dict.hero.titleRole}</span>
          </h1>
          <p class="max-w-xl text-xl leading-relaxed text-slate-400">
            {dict.hero.subtitlePrefix}<span
              class="font-semibold text-white underline decoration-primary/50 decoration-4"
              >{dict.hero.subtitleHighlight}</span
            >{dict.hero.subtitleSuffix}
          </p>
        </div>
        <div class="flex flex-wrap gap-4" data-reveal>
          <a
            class="flex items-center gap-2 rounded-xl bg-primary px-8 py-4 text-base font-bold text-white shadow-lg shadow-primary/30 transition-all hover:bg-primary-dark"
            href="#showcase"
          >
            {dict.hero.watchShowcase}
            <Icon name="play" class="size-5" />
          </a>
          <a
            class="rounded-xl border border-slate-700 bg-slate-800 px-8 py-4 text-base font-bold text-white transition-all hover:bg-slate-700"
            href={site.linkedin}
            target="_blank"
            rel="noopener noreferrer"
          >
            {dict.hero.linkedin}
          </a>
        </div>
        <div
          class="mt-4 flex items-center gap-10 border-t border-slate-800 pt-8"
          data-reveal
        >
          {
            site.stats.map((stat) => (
              <div class="flex flex-col">
                <span
                  class={`text-3xl font-extrabold ${stat.accent ? 'text-primary' : 'text-white'}`}
                >
                  {stat.value}
                </span>
                <span class="text-xs font-bold uppercase tracking-widest text-slate-500">
                  {dict.hero.stats[stat.key as keyof typeof dict.hero.stats]}
                </span>
              </div>
            ))
          }
        </div>
        <div
          class="mt-6 flex flex-col gap-3 border-t border-slate-800 pt-6"
          data-reveal
        >
          <span class="font-mono text-[10px] font-bold uppercase tracking-widest text-slate-500">
            {dict.hero.evidence.label}
          </span>
          <div class="flex flex-wrap items-center gap-3">
            {site.evidenceStack.map((stack) => (
              <a
                href="#skills"
                class="inline-flex items-center gap-2"
                aria-label={`${stack.id} — ${statusLabel(stack.status)}`}
              >
                <Badge status={stack.status} size="sm" label={stack.id} />
                <span class="text-xs font-bold uppercase tracking-widest text-slate-400">
                  {statusLabel(stack.status)}
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>
      <div class="lg:col-span-6">
        <div class="relative" data-reveal>
          <div class="absolute -inset-4 rounded-[2rem] bg-primary/20 blur-2xl"
          ></div>
          <div
            id="showcase"
            class="relative z-10 overflow-hidden rounded-2xl border-4 border-slate-800 shadow-2xl"
          >
            <svg
              viewBox="0 0 640 360"
              class="block h-auto w-full"
              role="img"
              aria-label={dict.hero.showcaseLabel}
            >
              <rect width="640" height="360" fill="#0b1120"></rect>
              <rect width="640" height="36" fill="#1e293b"></rect>
              <circle cx="20" cy="18" r="5" fill="#ef4444"></circle>
              <circle cx="40" cy="18" r="5" fill="#f59e0b"></circle>
              <circle cx="60" cy="18" r="5" fill="#22c55e"></circle>
              <text
                x="320"
                y="23"
                text-anchor="middle"
                font-family="JetBrains Mono, ui-monospace, monospace"
                font-size="11"
                fill="#64748b">armando@avantec: ~/profile</text>
              <g font-family="JetBrains Mono, ui-monospace, monospace" font-size="14">
                <text x="28" y="76">
                  <tspan fill="#3b82f6">$</tspan><tspan fill="#e2e8f0" dx="8">whoami</tspan>
                </text>
                <text x="28" y="104" fill="#94a3b8">armando.rojas</text>
                <text x="28" y="148">
                  <tspan fill="#3b82f6">$</tspan><tspan fill="#e2e8f0" dx="8">cat stack.txt</tspan>
                </text>
                <text x="28" y="176">
                  <tspan fill="#60a5fa">python</tspan><tspan fill="#475569" dx="8">·</tspan><tspan
                    fill="#34d399"
                    dx="8">fastapi</tspan><tspan fill="#475569" dx="8">·</tspan><tspan
                    fill="#fbbf24"
                    dx="8">odoo</tspan>
                </text>
                <text x="28" y="220">
                  <tspan fill="#3b82f6">$</tspan><tspan fill="#e2e8f0" dx="8">./role --current</tspan>
                </text>
                <text x="28" y="248">
                  <tspan fill="#e2e8f0">system-architect</tspan><tspan fill="#475569" dx="8">@</tspan><tspan
                    fill="#60a5fa"
                    dx="8">avantec.ds</tspan>
                </text>
                <text x="28" y="292">
                  <tspan fill="#34d399">✓</tspan><tspan fill="#94a3b8" dx="8">leading backend team</tspan>
                </text>
                <rect
                  class="terminal-cursor"
                  x="30"
                  y="306"
                  width="9"
                  height="16"
                  rx="1"
                  fill="#3b82f6"></rect>
              </g>
            </svg>
          </div>
          <div
            class="absolute -bottom-6 -right-6 z-20 hidden items-center gap-4 rounded-xl border border-slate-700 bg-background-card p-4 shadow-2xl md:flex"
          >
            <div class="rounded-lg bg-primary/20 p-2">
              <Icon name="verified" class="size-6 text-primary" />
            </div>
            <div>
              <p class="text-xs font-bold uppercase text-slate-500">
                {dict.hero.certLabel}
              </p>
              <p class="text-sm font-bold text-white">{dict.hero.certValue}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
