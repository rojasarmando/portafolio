---
import site from '../data/site.json';
import { t, type Lang } from '../i18n/utils';
import ShowcaseCard from './ShowcaseCard.astro';
import type { ShowcaseEntry } from '../types/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);

const entries = (site.showcase as ShowcaseEntry[])
  .slice()
  .sort((a, b) => {
    if (a.type === b.type) return a.order - b.order;
    const aIsRoadmap = a.type === 'learning-roadmap' ? 1 : 0;
    const bIsRoadmap = b.type === 'learning-roadmap' ? 1 : 0;
    return aIsRoadmap - bIsRoadmap;
  });
---

<section class="bg-slate-900/50 py-24" id="projects">
  <div class="mx-auto max-w-[1280px] px-6">
    <div class="mb-16 flex flex-col items-center gap-4 text-center" data-reveal>
      <span
        class="font-mono text-sm font-bold uppercase tracking-[0.2em] text-primary"
      >
        {dict.showcase.eyebrow}
      </span>
      <h2 class="text-4xl font-extrabold tracking-tight text-white">
        {dict.showcase.title}
      </h2>
      <p class="mt-2 max-w-2xl text-lg text-slate-500">
        {dict.showcase.subtitle}
      </p>
    </div>
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {entries.map((entry) => <ShowcaseCard entry={entry} lang={lang} />)}
    </div>
  </div>
</section>