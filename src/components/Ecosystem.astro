---
import site from '../data/site.json';
import { t, type Lang } from '../i18n/utils';
import EvidenceStackCard from './EvidenceStackCard.astro';
import type { EvidenceStackItem } from '../types/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const items = site.evidenceStack as EvidenceStackItem[];
---

<section class="bg-slate-900/50 py-24" id="skills">
  <div class="mx-auto max-w-[1280px] px-6">
    <div class="mb-16 flex flex-col items-center gap-4 text-center" data-reveal>
      <span
        class="font-mono text-sm font-bold uppercase tracking-[0.2em] text-primary"
      >
        {dict.evidenceStack.eyebrow}
      </span>
      <h2 class="text-4xl font-extrabold tracking-tight text-white">
        {dict.evidenceStack.title}
      </h2>
      <p class="mt-2 max-w-2xl text-lg text-slate-500">
        {dict.evidenceStack.subtitle}
      </p>
      <div class="h-1.5 w-16 rounded-full bg-primary"></div>
    </div>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      {items.map((item) => <EvidenceStackCard item={item} lang={lang} />)}
    </div>
  </div>
</section>